# Cloudflare Pages headers. state.json is live data (confidence/targets) — never
# cache it at the edge, or the site shows stale/blank confidence after a refresh.
/state.json
  Cache-Control: no-store, max-age=0
  Content-Type: application/json

# HTML pages: revalidate against origin so a new deploy shows immediately on every
# device, instead of the edge serving a stale landing/brief for minutes after a push.
/
  Cache-Control: no-cache
/brief/*
  Cache-Control: no-cache
