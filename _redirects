# Legacy /build/ URL → canonical /whats-real/ (301; content never lived in a build/ folder)
# (a top-level build/ folder broke Workers Builds — treated as compile output)
/build /whats-real/ 301
/build/ /whats-real/ 301
/build/* /whats-real/:splat 301

# Claim check alias → canonical short path
/tools/claim-check /tools/claims/ 301
/tools/claim-check/ /tools/claims/ 301
/tools/claim-check/* /tools/claims/:splat 301

# Shipping gates alias → canonical path
/tools/before-it-ships /tools/shipping-gates/ 301
/tools/before-it-ships/ /tools/shipping-gates/ 301
/tools/before-it-ships/* /tools/shipping-gates/:splat 301

# Common mistype → well-known security.txt (RFC 9116)
/security.txt /.well-known/security.txt 301
